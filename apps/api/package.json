{
  "name": "marquinhos-web-api",
  "version": "1.0.0",
  "description": "Marquinhos API",
  "main": "dist",
  "type": "module",
  "dependencies": {
    "@colyseus/schema": "^4.0.30",
    "@colyseus/testing": "^0.17.11",
    "@colyseus/ws-transport": "^0.17.13",
    "@marquinhos/contracts": "workspace:*",
    "@marquinhos/database": "workspace:*",
    "@marquinhos/domain": "workspace:*",
    "@nestjs/common": "12.4.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/schedule": "12.0.3",
    "@nestjs/throttler": "6.7.1",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "colyseus": "^0.17.10",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dockerode": "^5.0.1",
    "drizzle-orm": "0.45.3",
    "express": "^5.2.1",
    "morgan": "^1.11.0",
    "nanoid": "^6.0.1",
    "openai": "^6.48.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "spotify-web-api-node": "^5.0.2",
    "tslib": "^2.8.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.17.43",
    "@eslint/js": "^10.0.1",
    "@marquinhos/api-client": "workspace:*",
    "@marquinhos/eslint-config": "workspace:*",
    "@nestjs/testing": "12.4.0",
    "@types/autocannon": "^7.12.7",
    "@types/bun": "^1.3.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "@types/spotify-web-api-node": "^5.0.11",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "autocannon": "^8.0.0",
    "eslint": "^10.6.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "3.9.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "bun build src/main.ts --target=bun --outdir=./dist --sourcemap=external --external cpu-features --external class-validator --external class-transformer --external '@nestjs/microservices' --external '@nestjs/microservices/*' --external '@nestjs/websockets' --external '@nestjs/websockets/*'",
    "dev": "bun scripts/prepareDevelopmentWordle.ts && bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "MARQUINHOS_SECRET_KEY=test OPENAI_API_KEY=test bun test",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "clean": "rm -rf dist/ .logs/",
    "start": "bun run src/main.ts",
    "profile": "bun --inspect src/main.ts",
    "bench": "bun scripts/bench/run.ts"
  },
  "author": "Devaneios",
  "license": "ISC"
}
