  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug API (Bun)",
      "skipFiles": ["<node_internals>/**"],
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--inspect-brk", "src/main.ts"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
