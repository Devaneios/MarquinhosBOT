{
  "name": "marquinhos-monorepo",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "bun --no-env-file dev/cli.ts up",
    "dev:down": "bun --no-env-file dev/cli.ts down",
    "dev:doctor": "bun --no-env-file dev/cli.ts doctor",
    "dev:register": "bun --no-env-file dev/cli.ts register",
    "dev:test": "bun --no-env-file dev/cli.ts test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:deploy-env": "bash .github/scripts/write-deploy-env.test.sh",
    "test:dev": "SQLITE_PATH=:memory: bun test ./dev apps/activity/devGateway.test.ts && tsc -p dev/tsconfig.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "3.9.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
